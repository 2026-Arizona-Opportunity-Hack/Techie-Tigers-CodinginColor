# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # bypasses RLS: backend only, never in the frontend

# Origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173

# OPENAI_BASE_URL=https://ai.ohack.dev/v1      # OHack AI gateway (see your team card)
# OPENAI_API_KEY=sk-your-key                   # keep the real one in .env only
